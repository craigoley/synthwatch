{
  "name": "synthwatch-runner",
  "version": "0.1.0",
  "private": true,
  "description": "SynthWatch data-plane runner: executes HTTP and real-browser synthetic checks on a timer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:sarif": "eslint . -f @microsoft/eslint-formatter-sarif -o eslint-results.sarif"
  },
  "dependencies": {
    "@azure/communication-email": "1.1.0",
    "@azure/identity": "^4.13.2",
    "@azure/storage-blob": "12.33.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.28.2",
    "pg": "8.23.0",
    "playwright": "1.62.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
